extends layout

block content


  h1.text-center 連線小學堂 - HR 數位憑證測試
  img.img-fluid.mx-auto.d-block.rounded.mb-4(src="/images/avatar_candle.png" alt="Avatar" style="max-width: 200px")

  ul.nav.nav-tabs.mb-4
    li.nav-item
      a.nav-link.active(href="/") 申請員工卡
    li.nav-item
      a.nav-link(href="/support_checkin") 運動補助（驗證)
    li.nav-item
      a.nav-link(href="/subsidy_checkin") 育兒補助(驗證)


  .card.mb-4.shadow-sm
    .card-body
      .alert.alert-primary.mb-4
        h3.h5.fw-bold.mb-3 關於 HR 數位員工卡系統
        p.text-secondary
          | 這是一個 HR 的範例網頁，你可以申請一個員工卡片，並且透過申請補助來驗證員工身份。
        .card.mt-3
          .card-body
            h4.h6.fw-bold.mb-2 可申請的補助類型
            ul.text-secondary
              li.mb-2 
                strong 育兒補助：
                | 為有孩童的員工提供育兒相關補助
              li.mb-2 
                strong 體育補助：
                | 鼓勵員工參與運動健身活動的補助
            p.small.text-muted.mt-3
              | 透過數位員工卡驗證身份，簡化補助申請流程

      .mb-4
        .border-bottom.pb-4
          h3.h5.fw-bold.mb-3.d-flex.align-items-center
            span.badge.bg-warning.rounded-circle.me-2.p-2 壹
            | 下載數位皮夾測試版 App

          .alert.alert-warning.mb-4
            p.mb-0
              i.fas.fa-info-circle.me-2
              strong 注意事項：
              br
              | • iOS 用戶需先安裝 TestFlight 才能下載測試版本
              br
              | • Android 用戶需先加入測試成員名單才能下載

          .row.g-4
            .col-12.col-md-6
              .card.text-center.bg-light
                .card-body
                  h4.h6.fw-bold.mb-3 Android 版本
                  .row
                    .col-12.mb-3
                      a(href="https://play.google.com/apps/testing/tw.gov.moda.diw" target="_blank" title="下載 Android 版本(另開新視窗)")
                        img.img-fluid(style="width: 160px" src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=https://play.google.com/apps/testing/tw.gov.moda.diw" loading="lazy" alt="Android 版本 QR Code(另開新視窗)")
                    .col-12.mb-3
                      a(href="https://play.google.com/apps/testing/tw.gov.moda.diw" target="_blank" title="下載 Android 版本(另開新視窗)")
                        img.img-fluid(style="width: 160px" src="/images/googleplay.png" loading="lazy" alt="Google Play 商店下載按鈕(另開新視窗)")
                    .col-12
                      small.text-muted 支援 Android 10 以上

            .col-12.col-md-6
              .card.text-center.bg-light
                .card-body
                  h4.h6.fw-bold.mb-3 iOS 版本
                  .row
                    .col-12.mb-3
                      a(href="https://testflight.apple.com/join/gxr3mQFj" target="_blank" title="下載 iOS 版本(另開新視窗)")
                        img.img-fluid(style="width: 160px" src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=https://testflight.apple.com/join/gxr3mQFj" loading="lazy" alt="iOS 版本 QR Code(另開新視窗)")
                    .col-12.mb-3
                      a(href="https://testflight.apple.com/join/gxr3mQFj" target="_blank" title="下載 iOS 版本(另開新視窗)")
                        img.img-fluid(style="width: 160px" src="/images/applestore.png" loading="lazy" alt="Apple Store 下載按鈕(另開新視窗)")
                    .col-12
                      small.text-muted 支援 iOS 15.0 以上

      .card.bg-light
        .card-body
          h3.h5.fw-bold.mb-3.d-flex.align-items-center
            span.badge.bg-warning.rounded-circle.me-2.p-2 貳
            | 取得數位員工卡

          p.text-center.mb-3 請填寫以下資訊以取得您的數位員工卡 QR Code

          form.mx-auto(style="max-width: 480px" action="/generateVC" method="POST")
            .mb-3
              label.form-label(for="name") 姓名：(必填，只能輸入中英文數字和_)
              input#name.form-control(type="text" name="name" pattern="[a-zA-Z0-9\u4e00-\u9fa5_]+" title="只能輸入中英文數字和_" required)
            
            .mb-3
              label.form-label(for="english_name") 英文名字：(必填，只能輸入英文數字和_)
              input#english_name.form-control(type="text" name="english_name" pattern="[a-zA-Z0-9_]+" title="只能輸入英文數字和_" required)
            
            .mb-3
              label.form-label(for="roc_birthday") 民國出生年月日：(必填，7碼數字，例：1130101)
              input#roc_birthday.form-control(type="text" name="roc_birthday" pattern="[0-9]{7}" title="只允許輸入數字且長度為7碼" maxlength="7" required)
              small.form-text.text-muted 格式：民國年+月+日，例如民國113年1月1日請輸入1130101
            
            .mb-3
              label.form-label(for="join_company") 入職時間：(必填，日期格式YYYY-MM-DD)
              input#join_company.form-control(type="text" name="join_company" pattern="[0-9]{4}-[0-9]{2}-[0-9]{2}" title="只允許輸入數字與-，日期格式 YYYY-MM-DD" placeholder="2024-01-01" required)
              small.form-text.text-muted 格式：YYYY-MM-DD，例如：2024-01-01
            
            .mb-3
              label.form-label(for="num_children") 幾個小孩：(必填，7碼數字)
              input#num_children.form-control(type="text" name="num_children" pattern="[0-9]{7}" title="只允許輸入數字且長度為7碼" maxlength="7" value="0000001" required)
              small.form-text.text-muted 請輸入7碼數字，例如：0000001
            
            button.btn.btn-warning.w-100(type="submit") 
              | 取得數位員工卡 QR Code
          
          script.
            // Add additional client-side validation
            document.querySelector('form').addEventListener('submit', function(e) {
              const name = document.getElementById('name').value;
              const englishName = document.getElementById('english_name').value;
              const rocBirthday = document.getElementById('roc_birthday').value;
              const joinCompany = document.getElementById('join_company').value;
              const numChildren = document.getElementById('num_children').value;
              
              // Validate name (Chinese, English, numbers, underscore)
              if (!/^[a-zA-Z0-9\u4e00-\u9fa5_]+$/.test(name)) {
                alert('姓名只能輸入中英文數字和_');
                e.preventDefault();
                return;
              }
              
              // Validate English name (English, numbers, underscore)
              if (!/^[a-zA-Z0-9_]+$/.test(englishName)) {
                alert('英文名字只能輸入英文數字和_');
                e.preventDefault();
                return;
              }
              
              // Validate ROC birthday (7 digits)
              if (!/^[0-9]{7}$/.test(rocBirthday)) {
                alert('民國出生年月日必須是7碼數字');
                e.preventDefault();
                return;
              }
              
              // Validate join company date (YYYY-MM-DD format)
              if (!/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/.test(joinCompany)) {
                alert('入職時間格式必須是YYYY-MM-DD');
                e.preventDefault();
                return;
              }
              
              // Validate number of children (7 digits)
              if (!/^[0-9]{7}$/.test(numChildren)) {
                alert('幾個小孩必須是7碼數字');
                e.preventDefault();
                return;
              }
            });


